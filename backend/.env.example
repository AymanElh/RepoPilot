# Copy this file to .env and fill in the two required values.
# Use plain NAME=value lines without quotes or export statements.
DB_PASSWORD=
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Optional. Authenticates repository lookups and archive downloads to raise GitHub's API rate limit.
# Leave blank for unauthenticated public repository indexing.
GITHUB_TOKEN=
