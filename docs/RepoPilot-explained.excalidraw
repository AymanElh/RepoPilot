upIds": ["oxd9css9toqw9ja2m0w1"], "frameId": null, "roundness": null, "seed": 2124124829, "version": 1, "versionNonce": 1751071224, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "RAG", "originalText": "RAG", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "tj1gm25len606n9rr7s2", "type": "text", "x": 56.0, "y": 824.0, "width": 546.5600000000001, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["oxd9css9toqw9ja2m0w1"], "frameId": null, "roundness": null, "seed": 1561395251, "version": 1, "versionNonce": 911606087, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Retrieval-Augmented Generation. Instead of asking the LLM\nfrom memory, you first RETRIEVE relevant documents (here:\ncode chunks) and put them in the prompt. The LLM then answers\nusing real code from the repo, with citations.", "originalText": "Retrieval-Augmented Generation. Instead of asking the LLM\nfrom memory, you first RETRIEVE relevant documents (here:\ncode chunks) and put them in the prompt. The LLM then answers\nusing real code from the repo, with citations.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "twdl9zs13c9xqym52xg8", "type": "rectangle", "x": 656.6666666666666, "y": 773.0, "width": 586.6666666666666, "height": 147.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["n2y8fv2bc2nnuvy8n1ut"], "frameId": null, "roundness": {"type": 3}, "seed": 929040693, "version": 1, "versionNonce": 1079891754, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "oxie0rnujjq9k6re4q6q", "type": "text", "x": 672.6666666666666, "y": 789.0, "width": 108.0, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["n2y8fv2bc2nnuvy8n1ut"], "frameId": null, "roundness": null, "seed": 188529176, "version": 1, "versionNonce": 1740563874, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Ingestion", "originalText": "Ingestion", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "y4lmct64z7w2sehe2atn", "type": "text", "x": 672.6666666666666, "y": 824.0, "width": 546.5600000000001, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["n2y8fv2bc2nnuvy8n1ut"], "frameId": null, "roundness": null, "seed": 1725850410, "version": 1, "versionNonce": 2111002108, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "The pipeline that prepares data for search: fetch → extract →\nsplit → embed → store. In RepoPilot it lives in the\n`repository` package (fetch/extract) and the `ingestion`\npackage (chunk/index).", "originalText": "The pipeline that prepares data for search: fetch → extract →\nsplit → embed → store. In RepoPilot it lives in the\n`repository` package (fetch/extract) and the `ingestion`\npackage (chunk/index).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "knwi5flul1rsrla8s8hm", "type": "rectangle", "x": 1273.3333333333333, "y": 773.0, "width": 586.66