s": null, "seed": 688694962, "version": 1, "versionNonce": 627815687, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "PAYMENTS", "originalText": "PAYMENTS", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "225aa35wfw5q52dezh0c", "type": "rectangle", "x": 830, "y": 9980.0, "width": 1030, "height": 123.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["z8cv2a6pg4gks6r6bilq"], "frameId": null, "roundness": {"type": 3}, "seed": 196932585, "version": 1, "versionNonce": 1542439575, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "pb01qcte9w0an6nbyzm2", "type": "text", "x": 846, "y": 9996.0, "width": 396.0, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["z8cv2a6pg4gks6r6bilq"], "frameId": null, "roundness": null, "seed": 1833149294, "version": 1, "versionNonce": 2133853706, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "What is an embedding, concretely?", "originalText": "What is an embedding, concretely?", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "2om7ztrj67dxlse33dcn", "type": "text", "x": 846, "y": 10031.0, "width": 974.4000000000001, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["z8cv2a6pg4gks6r6bilq"], "frameId": null, "roundness": null, "seed": 330725634, "version": 1, "versionNonce": 1228164801, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "AITestController /api/test/embedding shows it: embeddingModel.embed(code) returns a float[] of length 1536 (set in\napplication.yaml). Each number means nothing alone. Together they place the text in a 'meaning space' learned by the\nmodel. Code that does similar things lands close together, even with different words (verify ~ validate ~ check).", "originalText": "AITestController /api/test/embedding shows it: embeddingModel.embed(code) returns a float[] of length 1536 (set in\napplication.yaml). Each number means nothing alone. Together they place the text in a 'meaning space' learned by the\nmodel. Code that does similar things lands close together, even with different words (verify ~ validate ~ check).", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "k8tir0p8f8c8clrki72o", "type": "rectangle", "x": 830, "y": 10123.25, "width": 1030, "height": 173.5, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "#c5f6fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["8a2ibcltrh9vgky5cgag"], "frameId": null, "roundness": {"type": 3}, "seed": 27847681, "version": 1, "versionNonce": 2054834159, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "hft9zzcgl9fwvvskp30t", "type": "text", "x": 846, "y": 10139.25, "width": 420.0, "height": 25.0, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["8a2ibcltrh9vgky5cgag"], "frameId": null, "roundness": null, "seed": 1406262846, "version": 1, "versionNonce": 1912454596, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Cosine similarity / cosine distance", "originalText": "Cosine similarity / cosine distance", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "8j1ccm0w3c1za0dv6nyy", "type": "rectangle", "x": 846, "y": 10174.25, "width": 998, "height": 59.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["8a2ibcltrh9vgky5cgag"], "frameId": null, "roundness": {"type": 3}, "seed": 141473668, "version": 1, "versionNonce": 1222350127, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "j4q0rr1l9gvbmqq749q6", "type": "text", "x": 858, "y": 10186.25, "width": 617.4, "height": 35.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["8a2ibcltrh9vgky5cgag"], "frameId": null, "roundness": null, "seed": 971041452, "version": 1, "versionNonce": 327888220, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "similarity = (A·B) / (|A| × |B|)   → 1 = same direction, 0 = unrelated\ndistance   = 1 − similarity          (pgvector operator  <=> )", "originalText": "similarity = (A·B) / (|A| × |B|)   → 1 = same direction, 0 = unrelated\ndistance   = 1 − similarity          (pgvector operator  <=> )", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "f1pafl9woa2xgvgdofma", "type": "text", "x": 846, "y": 10243.25, "width": 982.8000000000001, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["8a2ibcltrh9vgky5cgag"], "frameId": null, "roundness": null, "seed": 842311594, "version": 1, "versionNonce": 339981760, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "It measures the ANGLE between two vectors, not their length. application.yaml: distance-type: COSINE_DISTANCE. The V3\nindex uses vector_cosine_ops to match.", "originalText": "It measures the ANGLE between two vectors, not their length. application.yaml: distance-type: COSINE_DISTANCE. The V3\nindex uses vector_cosine_ops to match.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "jl9vt3x8ve00h2k2p3aj", "type": "rectangle", "x": 830, "y": 10316.75, "width": 1030, "height": 123.25, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["lfwypeek035n8cqphli5"], "frameId": null, "roundness": {"type": 3}, "seed": 309365644, "version": 1, "versionNonce": 635877159, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "l692tulgelw8ivi3rqas", "type": "text", "x": 846, "y": 10332.75, "width": 216.0, "height": 25.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["lfwypeek035n8cqphli5"], "frameId": null, "roundness": null, "seed": 205262195, "version": 1, "versionNonce": 824941544, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Why batches of 10?", "originalText": "Why batches of 10?", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "1wcrv68jq12jf4ciwl3r", "type": "text", "x": 846, "y": 10367.75, "width": 957.6000000000001, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["lfwypeek035n8cqphli5"], "frameId": null, "roundness": null, "seed": 313790734, "version": 1, "versionNonce": 1682949160, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "index() calls vectorStore.add(documents.subList(i, end)) 10 at a time. Each add → embedding API call(s) + INSERTs.\nSmall batches keep each request under the provider's size and rate limits, and an error only affects one batch.\nsubList is a VIEW, so no copying happens.", "originalText": "index() calls vectorStore.add(documents.subList(i, end)) 10 at a time. Each add → embedding API call(s) + INSERTs.\nSmall batches keep each request under the provider's size and rate limits, and an error only affects one batch.\nsubList is a VIEW, so no copying happens.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "ljekbvxsogb205hu03y5", "type": "rectangle", "x": 40.0, "y": 10480.0, "width": 895.0, "height": 281.0, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "#c5f6fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ax1cq6fwtv1djjzqfe8e"], "frameId": null, "roundness": {"type": 3}, "seed": 1756341607, "version": 1, "versionNonce": 651483420, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "5tnlztwxol4bkuu5czec", "type": "text", "x": 56.0, "y": 10496.0, "width": 552.0, "height": 25.0, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ax1cq6fwtv1djjzqfe8e"], "frameId": null, "roundness": null, "seed": 145802672, "version": 1, "versionNonce": 300457536, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "The table (Flyway V3__create_vector_store.sql)", "originalText": "The table (Flyway V3__create_vector_store.sql)", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "fs7i19mo1rtsxof33qe6", "type": "rectangle", "x": 56.0, "y": 10531.0, "width": 863.0, "height": 164.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ax1cq6fwtv1djjzqfe8e"], "frameId": null, "roundness": {"type": 3}, "seed": 559966434, "version": 1, "versionNonce": 488329527, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "ixub4ibhif5sl1ya1ryz", "type": "text", "x": 68.0, "y": 10543.0, "width": 635.04, "height": 140.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ax1cq6fwtv1djjzqfe8e"], "frameId": null, "roundness": null, "seed": 1181182762, "version": 1, "versionNonce": 145946304, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "CREATE TABLE public.vector_store (\n  id        UUID PRIMARY KEY,     -- generated by Spring AI\n  content   TEXT,                 -- the chunk's code\n  metadata  JSON,                 -- {repositoryId, commitSha, filePath,\n                                  --  startLine, endLine}\n  embedding VECTOR(1536)          -- the 1536 floats\n);\nCREATE INDEX ... USING hnsw (embedding vector_cosine_ops);", "originalText": "CREATE TABLE public.vector_store (\n  id        UUID PRIMARY KEY,     -- generated by Spring AI\n  content   TEXT,                 -- the chunk's code\n  metadata  JSON,                 -- {repositoryId, commitSha, filePath,\n                                  --  startLine, endLine}\n  embedding VECTOR(1536)          -- the 1536 floats\n);\nCREATE INDEX ... USING hnsw (embedding vector_cosine_ops);", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "bvhuazun6fht60kusfhv", "type": "text", "x": 56.0, "y": 10705.0, "width": 806.4000000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ax1cq6fwtv1djjzqfe8e"], "frameId": null, "roundness": null, "seed": 718302668, "version": 1, "versionNonce": 420418098, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "VECTOR(1536) must equal the model's output size AND pgvector.dimensions in the yaml.\ninitialize-schema: false means Spring AI doesn't create the table; Flyway owns the schema.", "originalText": "VECTOR(1536) must equal the model's output size AND pgvector.dimensions in the yaml.\ninitialize-schema: false means Spring AI doesn't create the table; Flyway owns the schema.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "0tlxoun91fy6yo8dje7x", "type": "rectangle", "x": 965.0, "y": 10480.0, "width": 895.0, "height": 227.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["mbwu5jslhgmrzzqo17rv"], "frameId": null, "roundness": {"type": 3}, "seed": 968018510, "version": 1, "versionNonce": 1618565544, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "2y7cdabbajaq08dnx80n", "type": "text", "x": 981.0, "y": 10496.0, "width": 444.0, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["mbwu5jslhgmrzzqo17rv"], "frameId": null, "roundness": null, "seed": 601249637, "version": 1, "versionNonce": 896546561, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "HNSW index: how the search stays fast", "originalText": "HNSW index: how the search stays fast", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "xkbefq796ew8257ge0q5", "type": "text", "x": 981.0, "y": 10531.0, "width": 860.1600000000001, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["mbwu5jslhgmrzzqo17rv"], "frameId": null, "roundness": null, "seed": 1492326281, "version": 1, "versionNonce": 1197103624, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Without an index, every search compares the question to EVERY row (exact, but slow on millions\nof chunks). HNSW (Hierarchical Navigable Small World) builds a layered graph linking each vector\nto its neighbours. A search starts at the top layer and greedily walks toward the closest nodes,\nlayer by layer.", "originalText": "Without an index, every search compares the question to EVERY row (exact, but slow on millions\nof chunks). HNSW (Hierarchical Navigable Small World) builds a layered graph linking each vector\nto its neighbours. A search starts at the top layer and greedily walks toward the closest nodes,\nlayer by layer.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "jaucyhonbpqga6x85zzh", "type": "text", "x": 981.0, "y": 10621.0, "width": 842.2400000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["mbwu5jslhgmrzzqo17rv"], "frameId": null, "roundness": null, "seed": 573988972, "version": 1, "versionNonce": 52426249, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Result: approximate nearest neighbours in milliseconds. It may very rarely miss the exact best\nmatch, which is an accepted trade-off for semantic search.", "originalText": "Result: approximate nearest neighbours in milliseconds. It may very rarely miss the exact best\nmatch, which is an accepted trade-off for semantic search.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "y8gy39bu4uz2z0kdn3tn", "type": "text", "x": 981.0, "y": 10671.0, "width": 842.2400000000001, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["mbwu5jslhgmrzzqo17rv"], "frameId": null, "roundness": null, "seed": 1936645618, "version": 1, "versionNonce": 797301144, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Metadata is stored as JSON so you can filter on it later: repositoryId == 'x' AND filePath ...", "originalText": "Metadata is stored as JSON so you can filter on it later: repositoryId == 'x' AND filePath ...", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "wb4ll3k4bk8ejnfmoctc", "type": "rectangle", "x": 0, "y": 10941.0, "width": 1900, "height": 651.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 662252027, "version": 1, "versionNonce": 1586192413, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "ujt70y2rl4n7s3hmo1dx", "type": "text", "x": 40, "y": 10971.0, "width": 1056.0, "height": 50.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 974214745, "version": 1, "versionNonce": 334365740, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "8. Searching: GET /api/dev/code-search?q=...", "originalText": "8. Searching: GET /api/dev/code-search?q=...", "fontSize": 40, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "46ga2sdfc8io3td3abeg", "type": "text", "x": 40, "y": 11029.0, "width": 725.7600000000001, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1666593012, "version": 1, "versionNonce": 1461322942, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "CodeSearchController → CodeSearchService.search(question) → VectorStore.", "originalText": "CodeSearchController → CodeSearchService.search(question) → VectorStore.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "5ntdywm8rabr6rtc0z7q", "type": "rectangle", "x": 40.0, "y": 11081.5, "width": 250, "height": 130, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["cj8pmozknhpvrwbrblbz"], "frameId": null, "roundness": {"type": 3}, "seed": 1608577401, "version": 1, "versionNonce": 724523837, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "i9bl14hoae527psqzn7x", "type": "text", "x": 57.900000000000006, "y": 11125.25, "width": 214.2, "height": 42.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["cj8pmozknhpvrwbrblbz"], "frameId": null, "roundness": null, "seed": 104614405, "version": 1, "versionNonce": 543752108, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "q = \"Where is the JWT\ntoken validated?\"", "originalText": "q = \"Where is the JWT\ntoken validated?\"", "fontSize": 17, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "vzr6kfkldf4hra1361bg", "type": "arrow", "x": 294.0, "y": 11146.5, "width": 56.0, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 730295642, "version": 1, "versionNonce": 1858787948, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "points": [[0, 0], [56.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "kupcj8mo765efu