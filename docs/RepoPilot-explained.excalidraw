)", "originalText": "wrap\n(decorator)", "fontSize": 12, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "cnkfhb7v80lkx1s9xka4", "type": "arrow", "x": 910.0, "y": 6530.0, "width": 80.0, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 711397494, "version": 1, "versionNonce": 736003669, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "points": [[0, 0], [80.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "it6xiyzvnlpa5cgwfhdv", "type": "text", "x": 906.3199999999999, "y": 6506.0, "width": 87.36000000000001, "height": 15.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1785033242, "version": 1, "versionNonce": 1707750049, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "zip.read(buf)", "originalText": "zip.read(buf)", "fontSize": 12, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "7ic0lzigikqwj2c9ogps", "type": "arrow", "x": 1228.0, "y": 6530.0, "width": 80.0, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1578246096, "version": 1, "versionNonce": 930784888, "isDeleted": false, "boundElements": null, "updated": 