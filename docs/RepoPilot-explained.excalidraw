": "solid", "roughness": 1, "opacity": 100, "groupIds": ["po1i3msdn1mxf1pi2ooq"], "frameId": null, "roundness": null, "seed": 1130125304, "version": 1, "versionNonce": 864906995, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "…wrapped in JdkClientHttpRequestFactory so Spring's\nRestClient uses it. GithubArchiveClientTest checks exactly\nthis with a fake 302 server.", "originalText": "…wrapped in JdkClientHttpRequestFactory so Spring's\nRestClient uses it. GithubArchiveClientTest checks exactly\nthis with a fake 302 server.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "4ljedgfjdlogwlacolol", "type": "rectangle", "x": 656.6666666666666, "y": 6096.5, "width": 586.6666666666666, "height": 217.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["7n8voeubfn9kr2fvb66h"], "frameId": null, "roundness": {"type": 3}, "seed": 806408366, "version": 1, "versionNonce": 2022022311, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "3rem5puu62rzv1sqqq5l", "type": "text", "x": 672.6666666666666, "y": 6112.5, "width": 252.0, "height": 25.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["7n8voeubfn9kr2fvb66h"], "frameId": null, "roundness": null, "seed": 1717582372, "version": 1, "versionNonce": 1341684276, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "byte[] = the raw file", "originalText": "byte[] = the raw file", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "xoiot860x5zu2zueugwu", "type": "text", "x": 672.6666666666666, "y": 6147.5, "width": 501.76000000000005, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["7n8voeubfn9kr2fvb66h"], "frameId": null, "roundness": null, "seed": 113546871, "version": 1, "versionNonce": 2055770653, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "A zip is binary data, not text, so we ask for byte[] and\nnever for a String. One byte = 8 bits; a 5 MB repo is a\nbyte[] of about 5,000,000 elements.", "originalText": "A zip is binary data, not text, so we ask for byte[] and\nnever for a String. One byte = 8 bits; a 5 MB repo is a\nbyte[] of about 5,000,000 elements.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "ugr6e7ga2iz5p3vob5ap", "type": "text", "x": 672.6666666666666, "y": 6217.5, "width": 546.5600000000001, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["7n8voeubfn9kr2fvb66h"], "frameId": null, "roundness": null, "seed": 891069188, "version": 1, "versionNonce": 51661885, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Trade-off: the whole archive sits in memory before it is\nwritten. Fine for small repos. For big ones you would stream\nthe HTTP body straight to the file (InputStream → Files.copy)\nwithout holding it all in RAM.", "originalText": "Trade-off: the whole archive sits in memory before it is\nwritten. Fine for small repos. For big ones you would stream\nthe HTTP body straight to the file (InputStream → Files.copy)\nwithout holding it all in RAM.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "lymj1qi9mqvayxar6yo6", "type": "rectangle", "x": 1273.3333333333333, "y": 6096.5, "width": 586.6666666666666, "height": 227.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3eh1vr1necqoroi5j8yi"], "frameId": null, "roundness": {"type": 3}, "seed": 1510324549, "version": 1, "versionNonce": 1050069493, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "t2kodwh8n92tp6qaq3k8", "type": "text", "x": 1289.3333333333333, "y": 6112.5, "width": 192.0, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3eh1vr1necqoroi5j8yi"], "frameId": null, "roundness": null, "seed": 1165938, "version": 1, "versionNonce": 129224891, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Defensive checks", "originalText": "Defensive checks", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "7rv4nmwvsb0ukoefukpv", "type": "text", "x": 1289.3333333333333, "y": 6147.5, "width": 546.5600000000001, "height": 160.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["3eh1vr1necqoroi5j8yi"], "frameId": null, "roundness": null, "seed": 2056037725, "version": 1, "versionNonce": 1722403340, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• archive == null or length == 0 →\n  IllegalArgumentException('Empty repository archive')\n• If Files.write fails, the half-written temp file is\n  deleted, then the exception is rethrown (catch → cleanup →\n  throw e).\n• The URL uses {owner}/{repo}/{sha} template variables, which\n  RestClient URL-encodes. Never concatenate user input into\n  URLs.", "originalText": "• archive == null or length == 0 →\n  IllegalArgumentException('Empty repository archive')\n• If Files.write fails, the half-written temp file is\n  deleted, then the exception is rethrown (catch → cleanup →\n  throw e).\n• The URL uses {owner}/{repo}/{sha} template variables, which\n  RestClient URL-encodes. Never concatenate user input into\n  URLs.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "1t2xcb3yym33mg1zaq7q", "type": "text", "x": 40, "y": 6420.0, "width": 998.4, "height": 32.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 475712221, "version": 1, "versionNonce": 1595890556, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "4.2  Unzipping with streams  (RepositorySourceExtractor.extract)", "originalText": "4.2  Unzipping with streams  (RepositorySourceExtractor.extract)", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rtxuyucecjuis2gy9ytj", "type": "rectangle", "x": 40.0, "y": 6475.0, "width": 230, "height": 110, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ak7mdwkzirnk6zhh3o5u"], "frameId": null, "roundness": {"type": 3}, "seed": 1202839902, "version": 1, "versionNonce": 189