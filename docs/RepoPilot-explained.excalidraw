: null, "updated": 1795031332816, "link": null, "locked": false, "text": "flush/close", "originalText": "flush/close", "fontSize": 12, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "7xncmldqz05ev5kz3nwx", "type": "rectangle", "x": 40.0, "y": 6615.0, "width": 895.0, "height": 441.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["a1x7ov6sgp3jk8xnlo50"], "frameId": null, "roundness": {"type": 3}, "seed": 1020483002, "version": 1, "versionNonce": 1105769406, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "dw1mf07ol93aczsx0gnz", "type": "text", "x": 56.0, "y": 6631.0, "width": 396.0, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["a1x7ov6sgp3jk8xnlo50"], "frameId": null, "roundness": null, "seed": 425245846, "version": 1, "versionNonce": 1044689087, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "The extraction loop, line by line", "originalText": "The extraction loop, line by line", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "g8q3gcg1j6oww5fknjmv", "type": "rectangle", "x": 56.0, "y": 6666.0, "width": 863.0, "height": 374.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["a1x7ov6sgp3jk8xnlo50"], "frameId": null, "roundness": {"type": 3}, "seed": 1026276246, "version": 1, "versionNonce": 1041946939, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "ydc1au9dsav917rmpn69", "type": "text", "x": 68.0, "y": 6678.0, "width": 714.42, "height": 350.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["a1x7ov6sgp3jk8xnlo50"], "frameId": null, "roundness": null, "seed": 1754165989, "version": 1, "versionNonce": 514530696, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "try (ZipInputStream zip = new ZipInputStream(Files.newInputStream(zipFile))) {\n  ZipEntry entry;\n  while ((entry = zip.getNextEntry()) != null) {   // next file/folder in the zip\n    Path target = destination.resolve(entry.getName()).normalize();\n    if (!target.startsWith(destination)) throw ...;  // zip slip guard\n    if (entry.isDirectory()) Files.createDirectories(target);\n    else {\n      Files.createDirectories(target.getParent()); // parent may be missing\n      try (var output = Files.newOutputStream(target)) {\n        byte[] buffer = new byte[8192];\n        int n;\n        while ((n = zip.read(buffer)) != -1) {    // -1 = end of THIS entry\n          totalBytes += n;                        // zip bomb counter\n          output.write(buffer, 0, n);             // only the n bytes read!\n        }\n      }\n    }\n    zip.closeEntry();\n  }\n}", "originalText": "try (ZipInputStream zip = new ZipInputStream(Files.newInputStream(zipFile))) {\n  ZipEntry entry;\n  while ((entry = zip.getNextEntry()) != null) {   // next file/folder in the zip\n    Path target = destination.resolve(entry.getName()).normalize();\n    if (!target.startsWith(destination)) throw ...;  // zip slip guard\n    if (entry.isDirectory()) Files.createDirectories(target);\n    else {\n      Files.createDirectories(target.getParent()); // parent may be missing\n      try (var output = Files.newOutputStream(target)) {\n        byte[] buffer = new byte[8192];\n        int n;\n        while ((n = zip.read(buffer)) != -1) {    // -1 = end of THIS entry\n          totalBytes += n;                        // zip bomb counter\n          output.write(buffer, 0, n);             // only the n bytes read!\n        }\n      }\n    }\n    zip.closeEntry();\n  }\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "02grxpudc62g3aut3rsv", "type": "rectangle", "x": 965.0, "y": 6615.0, "width": 895.0, "height": 397.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": {"type": 3}, "seed": 1532764565, "version": 1, "versionNonce": 1758418893, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "60khfsu4se2kyt5gqexi", "type": "text", "x": 981.0, "y": 6631.0, "width": 324.0, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 454495211, "version": 1, "versionNonce": 366002109, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Stream concepts to remember", "originalText": "Stream concepts to remember", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "1xdpzf761hjr6eet0dy5", "type": "text", "x": 981.0, "y": 6666.0, "width": 779.5200000000001, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 2000982217, "version": 1, "versionNonce": 1236890631, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• InputStream / OutputStream = a one-way flow of BYTES (Reader/Writer = flow of CHARS).", "originalText": "• InputStream / OutputStream = a one-way flow of BYTES (Reader/Writer = flow of CHARS).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "1vxnz0nxu43iedd070en", "type": "text", "x": 981.0, "y": 6696.0, "width": 851.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 1832512881, "version": 1, "versionNonce": 672961863, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• Decorator pattern: new ZipInputStream(rawStream) wraps one stream in another to add a feature\n  (unzipping). It is the same idea as new BufferedReader(new FileReader(..)).", "originalText": "• Decorator pattern: new ZipInputStream(rawStream) wraps one stream in another to add a feature\n  (unzipping). It is the same idea as new BufferedReader(new FileReader(..)).", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "8uact49lny2svhotqf74", "type": "text", "x": 981.0, "y": 6746.0, "width": 842.2400000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 1073382472, "version": 1, "versionNonce": 1460247919, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• ZipInputStream reads the zip sequentially: getNextEntry() jumps to the next file, and read()\n  returns -1 when THAT entry is finished, not the whole zip.", "originalText": "• ZipInputStream reads the zip sequentially: getNextEntry() jumps to the next file, and read()\n  returns -1 when THAT entry is finished, not the whole zip.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "qvfx2zvl9e9zr3rzn9l3", "type": "text", "x": 981.0, "y": 6796.0, "width": 851.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 452288160, "version": 1, "versionNonce": 1821216348, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• Why a buffer? Reading byte by byte = millions of calls. Reading up to 8192 bytes at a time is\n  fast and uses constant memory, however big the file is.", "originalText": "• Why a buffer? Reading byte by byte = millions of calls. Reading up to 8192 bytes at a time is\n  fast and uses constant memory, however big the file is.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "03zb5gro9x49tmy91otk", "type": "text", "x": 981.0, "y": 6846.0, "width": 851.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 1495456749, "version": 1, "versionNonce": 1982264387, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• read() may fill the buffer only partly, so write(buffer, 0, n) writes just the n valid bytes.\n  write(buffer) would also write stale bytes from the previous read.", "originalText": "• read() may fill the buffer only partly, so write(buffer, 0, n) writes just the n valid bytes.\n  write(buffer) would also write stale bytes from the previous read.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "h4oe1u24zqfezkfh00a0", "type": "text", "x": 981.0, "y": 6896.0, "width": 824.32, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 1236267890, "version": 1, "versionNonce": 218931315, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• try-with-resources closes the stream even on exceptions. That releases the file handle and\n  flushes the data to disk.", "originalText": "• try-with-resources closes the stream even on exceptions. That releases the file handle and\n  flushes the data to disk.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "y9f8p47d9gb9xv8wobir", "type": "text", "x": 981.0, "y": 6946.0, "width": 734.72, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 1477434618, "version": 1, "versionNonce": 1280234137, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• A GitHub zip has ONE top folder: owner-repo-<sha>/. Folder entries end with '/'.", "originalText": "• A GitHub zip has ONE top folder: owner-repo-<sha>/. Folder entries end with '/'.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "8xny2x15xjxnecrysauu", "type": "text", "x": 981.0, "y": 6976.0, "width": 752.6400000000001, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["og983amb3lpvowcp7794"], "frameId": null, "roundness": null, "seed": 587819539, "version": 1, "versionNonce": 1489764928, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• If anything fails, the catch block deletes the half-extracted folder and rethrows.", "originalText": "• If anything fails, the catch block deletes the half-extracted folder and rethrows.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "2e186gvgt2eehfu4b9sn", "type": "text", "x": 40, "y": 7096.0, "width": 514.8, "height": 32.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1169148416, "version": 1, "versionNonce": 368515072, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "4.3  Walking and deleting folders", "originalText": "4.3  Walking and deleting folders", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "zg92sjp753k48oldc08f", "type": "rectangle", "x": 40.0, "y": 7151.0, "width": 586.6666666666666, "height": 301.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#ffe8cc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["p8ak8s2xquzs9mthd3ig"], "frameId": null, "roundness": {"type": 3}, "seed": 123290312, "version": 1, "versionNonce": 181645165, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "k38vhmewcjn6ocjpztc0", "type": "text", "x": 56.0, "y": 7167.0, "width": 408.0, "height": 25.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["p8ak8s2xquzs9mthd3ig"], "frameId": null, "roundness": null, "seed": 2137517754, "version": 1, "versionNonce": 1359614511, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "findJavaFiles: Files.walk + Stream", "originalText": "findJavaFiles: Files.walk + Stream", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "zgnx3vpf9pavcedtcxnm", "type": "rectangle", "x": 56.0, "y": 7202.0, "width": 554.6666666666666, "height": 164.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["p8ak8s2xquzs9mthd3ig"], "frameId": null, "roundness": {"type": 3}, "seed": 586806355, "version": 1, "versionNonce": 314240489, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "5ian8nd7g0l3rtz5tv6g", "type": "text", "x": 68.0, "y": 7214.0, "width": 458.64, "height": 140.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["p8ak8s2xquzs9mthd3ig"], "frameId": null, "roundness": null, "seed": 2032615404, "version": 1, "versionNonce": 1614634789, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "try (var paths = Files.walk(directory)) {\n  return paths\n    .filter(Files::isRegularFile)\n    .filter(p -> p.toString().endsWith(\".java\"))\n    .filter(p -> !p.toString().contains(\"/target/\"))\n    .filter(p -> !p.toString().contains(\"/build/\"))\n    .sorted().toList();\n}", "originalText": "try (var paths = Files.walk(directory)) {\n  return paths\n    .filter(Files::isRegularFile)\n    .filter(p -> p.toString().endsWith(\".java\"))\n    .filter(p -> !p.toString().contains(\"/target/\"))\n    .filter(p -> !p.toString().contains(\"/build/\"))\n    .sorted().toList();\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "om08tv4reasfen0b09zi", "type": "text", "x": 56.0, "y": 7376.0, "width": 528.6400000000001, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["p8ak8s2xquzs9mthd3ig"], "frameId": null, "roundness": null, "seed": 1307179713, "version": 1, "versionNonce": 898171606, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Files.walk is LAZY and keeps directories open while you\nconsume it, so it must be closed: hence try-with-resources.\n.toList() consumes everything before the stream closes.", "originalText": "Files.walk is LAZY and keeps directories open while you\nconsume it, so it must be closed: hence try-with-resources.\n.toList() consumes everything before the stream closes.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "ieb97pwdbolwimrsxkjk", "type": "rectangle", "x": 656.6666666666666, "y": 7151.0, "width": 586.6666666666666, "height": 317.5, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["0tr58ps0rs95zow60zz0"], "frameId": null, "roundness": {"type": 3}, "seed": 753819400, "version": 1, "versionNonce": 1528118433, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "i0835tvv8y5sic4s8pnn", "type": "text", "x": 672.6666666666666, "y": 7167.0, "width": 420.0, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["0tr58ps0rs95zow60zz0"], "frameId": null, "roundness": null, "seed": 243167105, "version": 1, "versionNonce": 725760556, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "deleteDirectory: why reverse order?", "originalText": "deleteDirectory: why reverse order?", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "6it1ekkh0uhk7x3bqwrm", "type": "text", "x": 672.6666666666666, "y": 7202.0, "width": 537.6, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["0tr58ps0rs95zow60zz0"], "frameId": null, "roundness": null, "seed": 1321841142, "version": 1, "versionNonce": 988602431, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "The OS refuses to delete a folder that is not empty.\nFiles.walk lists a parent BEFORE its children, so sorting in\nreverse puts the deepest files first:", "originalText": "The OS refuses to delete a folder that is not empty.\nFiles.walk lists a parent BEFORE its children, so sorting in\nreverse puts the deepest files first:", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "lma6gmdrdsferfxiokpg", "type": "rectangle", "x": 672.6666666666666, "y": 7272.0, "width": 554.6666666666666, "height": 111.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0tr58ps0rs95zow60zz0"], "frameId": null, "roundness": {"type": 3}, "seed": 1742777157, "version": 1, "versionNonce": 578707499, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "dp4fmpm5hgbo06fhrxjp", "type": "text", "x": 684.6666666666666, "y": 7284.0, "width": 352.8, "height": 87.5, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["0tr58ps0rs95zow60zz0"], "frameId": null, "roundness": null, "seed": 1181381599, "version": 1, "versionNonce": 1064223298, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "repopilot-src-5521/        ← deleted 5th\n└─ petclinic-9f3c/          ← 4th\n   ├─ pom.xml               ← 3rd\n   └─ src/                  ← 2nd\n      └─ Owner.java         ← 1st", "originalText": "repopilot-src-5521/        ← deleted 5th\n└─ petclinic-9f3c/          ← 4th\n   ├─ pom.xml               ← 3rd\n   └─ src/                  ← 2nd\n      └─ Owner.java         ← 1st", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "2zl15s74nddafs1iym90", "type": "rectangle", "x": 672.6666666666666, "y": 7393.5, "width": 554.6666666666666, "height": 59.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["0tr58ps0rs95zow60zz0"], "frameId": null, "roundness": {"type": 3}, "seed": 932713378, "version": 1, "versionNonce": 1031206651, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "kr1ifsi159i3hz3zsg9v", "type": "text", "x": 684.6666666666666, "y": 7405.5, "width": 379.26, "height": 35.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["0tr58ps0rs95zow60zz0"], "frameId": null, "roundness": null, "seed": 1362529404, "version": 1, "versionNonce": 319386867, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "paths.sorted(Comparator.reverseOrder())\n     .toList()  // then deleteIfExists each", "originalText": "paths.sorted(Comparator.reverseOrder())\n     .toList()  // then deleteIfExists each", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "gg5gr0xafgovcci68ds0", "type": "rectangle", "x": 1273.3333333333333, "y": 7151.0, "width": 586.6666666666666, "height": 276.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["plbbb0hq6dg8nkdat5l0"], "frameId": null, "roundness": {"type": 3}, "seed": 1735151180, "version": 1, "versionNonce": 25315674, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "n2tnxhn5e0ev6xgz7ctm", "type": "text", "x": 1289.3333333333333, "y": 7167.0, "width": 276.0, "height": 25.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["plbbb0hq6dg8nkdat5l0"], "frameId": null, "roundness": null, "seed": 1557678679, "version": 1, "versionNonce": 1018333554, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Text vs bytes: charsets", "originalText": "Text vs bytes: charsets", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "9hzbgtj54696qz6cp7sa", "type": "text", "x": 1289.3333333333333, "y": 7202.0, "width": 546.5600000000001, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["plbbb0hq6dg8nkdat5l0"], "frameId": null, "roundness": null, "seed": 1286672690, "version": 1, "versionNonce": 588729722, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Files on disk are bytes. To get Strings you need an encoding.", "originalText": "Files on disk are bytes. To get Strings you need an encoding.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "zebu2y0oy58f1n2ojgfh", "type": "rectangle", "x": 1289.3333333333333, "y": 7232.0, "width": 554.6666666666666, "height": 59.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["plbbb0hq6dg8nkdat5l0"], "frameId": null, "roundness": {"type": 3}, "seed": 1496198569, "version": 1, "versionNonce": 19029539, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "52qzskhztgbibf57j2xi", "type": "text", "x": 1301.3333333333333, "y": 7244.0, "width": 423.36, "height": 35.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["plbbb0hq6dg8nkdat5l0"], "frameId": null, "roundness": null, "seed": 1768260086, "version": 1, "versionNonce": 450912258, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Files.readAllLines(file, StandardCharsets.UTF_8)\n\"...\".getBytes(StandardCharsets.UTF_8)", "originalText": "Files.readAllLines(file, StandardCharsets.UTF_8)\n\"...\".getBytes(StandardCharsets.UTF_8)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "tamvncztzowlc33h8g8t", "type": "text", "x": 1289.3333333333333, "y": 7301.0, "width": 537.6, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["plbbb0hq6dg8nkdat5l0"], "frameId": null, "roundness": null, "seed": 2101876222, "version": 1, "versionNonce": 1863977014, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Always name the charset explicitly. The platform default\nchanges between machines, and with the wrong one, accents in\ncomments come out garbled.", "originalText": "Always name the charset explicitly. The platform default\nchanges between machines, and with the wrong one, accents in\ncomments come out garbled.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "22d0nx5wt3hju31fi0n6", "type": "text", "x": 1289.3333333333333, "y": 7371.0, "width": 510.72, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundCol