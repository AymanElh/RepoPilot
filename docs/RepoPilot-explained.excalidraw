Family": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "bkern6yjmk3tgmalwvmb", "type": "rectangle", "x": 1130, "y": 8645.5, "width": 730, "height": 401.25, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xd6lqga3qupo4jnmyk85"], "frameId": null, "roundness": {"type": 3}, "seed": 1586303875, "version": 1, "versionNonce": 850864313, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "16sp18obs7587h91el88", "type": "text", "x": 1146, "y": 8661.5, "width": 156.0, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xd6lqga3qupo4jnmyk85"], "frameId": null, "roundness": null, "seed": 664159871, "version": 1, "versionNonce": 1702661267, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "The algorithm", "originalText": "The algorithm", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "12qfaf5kcihdiy4nrmqy", "type": "rectangle", "x": 1146, "y": 8696.5, "width": 698, "height": 164.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["xd6lqga3qupo4jnmyk85"], "frameId": null, "roundness": {"type": 3}, "seed": 1500618093, "version": 1, "versionNonce": 456322830, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "6y3z1de1e1630pocr0vh", "type": "text", "x": 1158, "y": 8708.5, "width": 643.86, "height": 140.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xd6lqga3qupo4jnmyk85"], "frameId": null, "roundness": null, "seed": 1306791763, "version": 1, "versionNonce": 382595746, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "int step = CHUNK_SIZE - OVERLAP;                 // 80\nfor (int start = 0; start < lines.size(); start += step) {\n    int end = Math.min(start + CHUNK_SIZE, lines.size());\n    String content = String.join(\"\\n\", lines.subList(start, end));\n    if (!content.isBlank())\n        chunks.add(new CodeChunk(relativePath, start + 1, end, content));\n    if (end == lines.size()) break;              // reached the end\n}", "originalText": "int step = CHUNK_SIZE - OVERLAP;                 // 80\nfor (int start = 0; start < lines.size(); start += step) {\n    int end = Math.min(start + CHUNK_SIZE, lines.size());\n    String content = String.join(\"\\n\", lines.subList(start, end));\n    if (!content.isBlank())\n        chunks.add(new CodeChunk(relativePath, start + 1, end, content));\n    if (end == lines.size()) break;              // reached the end\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "1nm3v16xeghpmxpkn3b8", "type": "rectangle", "x": 1146, "y": 8870.5, "width": 698, "height": 94.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["xd6lqga3qupo4jnmyk85"], "frameId": null, "roundness": {"type": 3}, "seed": 905673084, "version": 1, "versionNonce": 385511876, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "fy4qcyd52alunqr8o1kj", "type": "text", "x": 1158, "y": 8882.5, "width": 670.32, "height": 70.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xd6lqga3qupo4jnmyk85"], "frameId": null, "roundness": null, "seed": 1361756280, "version": 1, "versionNonce": 249018811, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "iteration | start (0-based) | end = min(start+100, 250) | chunk lines\n    1     |       0         |          100              |   1 – 100\n    2     |      80         |          180              |  81 – 180\n    3     |     160         |          250 (capped)     | 161 – 250  → break", "originalText": "iteration | start (0-based) | end = min(start+100, 250) | chunk lines\n    1     |       0         |          100              |   1 – 100\n    2     |      80         |          180              |  81 – 180\n    3     |     160         |          250 (capped)     | 161 – 250  → break", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "v2qnrmtn29tnyfm7vh30", "type": "text", "x": 1146, "y": 8974.5, "width": 688.8000000000001, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xd6lqga3qupo4jnmyk85"], "frameId": null, "roundness": null, "seed": 977082215, "version": 1, "versionNonce": 933914973, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "subList(start, end) uses 0-based indexes and EXCLUDES end. Humans count lines from\n1, so startLine = start + 1, and endLine = end works out exactly (index 99 = line\n100).", "originalText": "subList(start, end) uses 0-based indexes and EXCLUDES end. Humans count lines from\n1, so startLine = start + 1, and endLine = end works out exactly (index 99 = line\n100).", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "halckz3vwlo7ammpq0hz", "type": "rectangle", "x": 1130, "y": 9066.75, "width": 730, "height": 235.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["idd0wpj8yi340sqcnf9w"], "frameId": null, "roundness": {"type": 3}, "seed": 1445226328, "version": 1, "versionNonce": 837650166, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "5n9c70pa8jx54pegjks4", "type": "text", "x": 1146, "y": 9082.75, "width": 300.0, "height": 25.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["idd0wpj8yi340sqcnf9w"], "frameId": null, "roundness": null, "seed": 523454301, "version": 1, "versionNonce": 1490905846, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Small details that matter", "originalText": "Small details that matter", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "2nr1p02jyv6yjoaoejv9", "type": "text", "x": 1146, "y": 9117.75, "width": 697.2, "height": 168.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["idd0wpj8yi340sqcnf9w"], "frameId": null, "roundness": null, "seed": 683242105, "version": 1, "versionNonce": 208623104, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• break when end == size: without it, a 250-line file would also make a 4th chunk\n  (241–250) that is already inside chunk 3.\n• isBlank(): a window of only empty lines is skipped, since embedding it is wasted\n  money.\n• relativePath = root.relativize(file) with '\\' → '/', e.g.\n  \"spring-petclinic-9f3c/src/main/java/.../Owner.java\". It is stored so answers can\n  cite files. On Windows Path.toString() uses '\\', so it is normalized.\n• The bug you saw earlier: the constants were 20/10, which made 24 chunks instead\n  of 3.", "originalText": "• break when end == size: without it, a 250-line file would also make a 4th chunk\n  (241–250) that is already inside chunk 3.\n• isBlank(): a window of only empty lines is skipped, since embedding it is wasted\n  money.\n• relativePath = root.relativize(file) with '\\' → '/', e.g.\n  \"spring-petclinic-9f3c/src/main/java/.../Owner.java\". It is stored so answers can\n  cite files. On Windows Path.toString() uses '\\', so it is normalized.\n• The bug you saw earlier: the constants were 20/10, which made 24 chunks instead\n  of 3.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "6nx9owwew9v08liuqdn0", "type": "rectangle", "x": 40.0, "y": 9322.5, "width": 586.6666666666666, "height": 167.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["jb48wumh9nklybwgmp9a"], "frameId": null, "roundness": {"type": 3}, "seed": 1897328606, "version": 1, "versionNonce": 1696254092, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "9uri7ev4dh9ugf10oo1p", "type": "text", "x": 56.0, "y": 9338.5, "width": 204.0, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["jb48wumh9nklybwgmp9a"], "frameId": null, "roundness": null, "seed": 1286876447, "version": 1, "versionNonce": 598889644, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Why split at all?", "originalText": "Why split at all?", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "lnd581lto4rq3q7gktmq", "type": "text", "x": 56.0, "y": 9373.5, "width": 546.5600000000001, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["jb48wumh9nklybwgmp9a"], "frameId": null, "roundness": null, "seed": 369948447, "version": 1, "versionNonce": 1467486758, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "An embedding is ONE vector for the whole text you give it. A\nvector for a 2,000-line file averages everything together and\nmatches nothing well. A 100-line window is about one class\nsection or a few methods, so its vector is specific.\nEmbedding models also have a maximum input size.", "originalText": "An embedding is ONE vector for the whole text you give it. A\nvector for a 2,000-line file averages everything together and\nmatches nothing well. A 100-line window is about one class\nsection or a few methods, so its vector is specific.\nEmbedding models also have a maximum input size.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "m62hdxc6rijkq2zuv1fk", "type": "rectangle", "x": 656.6666666666666, "y": 9322.5, "width": 586.6666666666666, "height": 167.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xt54fn5g77lk6hqiv929"], "frameId": null, "roundness": {"type": 3}, "seed": 474640132, "version": 1, "versionNonce": 1890151966, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "sevl7fq8aby595cpjze1", "type": "text", "x": 672.6666666666666, "y": 9338.5, "width": 144.0, "height": 25.0, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xt54fn5g77lk6hqiv929"], "frameId": null, "roundness": null, "seed": 1389613771, "version": 1, "versionNonce": 2124309746, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Why overlap?", "originalText": "Why overlap?", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "tar0ko31nzsxpefj31eg", "type": "text", "x": 672.6666666666666, "y": 9373.5, "width": 537.6, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["xt54fn5g77lk6hqiv929"], "frameId": null, "roundness": null, "seed": 886681082, "version": 1, "versionNonce": 1409902478, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Line-based cuts are blind: a method on lines 90–110 would be\ncut in half. With 20 lines of overlap, anything up to 20\nlines long that crosses a border shows up whole in the next\nchunk. The cost is about 25% more chunks, so more embedding\ncalls and more rows.", "originalText": "Line-based cuts are blind: a method on lines 90–110 would be\ncut in half. With 20 lines of overlap, anything up to 20\nlines long that crosses a border shows up whole in the next\nchunk. The cost is about 25% more chunks, so more embedding\ncalls and more rows.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "t058cuij0yxiyqbvtdg3", "type": "rectangle", "x": 1273.3333333333333, "y": 9322.5, "width": 586.6666666666666, "height": 167.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["nnk8fwrpk0zfknwbhkvj"], "frameId": null, "roundness": {"type": 3}, "seed": 136727992, "version": 1, "versionNonce": 1945922901, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "z09owgmf4ln5rgsg6a8m", "type": "text", "x": 1289.3333333333333, "y": 9338.5, "width": 228.0, "height": 25.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["nnk8fwrpk0zfknwbhkvj"], "frameId": null, "roundness": null, "seed": 664234486, "version": 1, "versionNonce": 443303465, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Tuning & the future", "originalText": "Tuning & the future", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "ik22xmq66442sihxodlc", "type": "text", "x": 1289.3333333333333, "y": 9373.5, "width": 537.6, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["nnk8fwrpk0zfknwbhkvj"], "frameId": null, "roundness": null, "seed": 1188169364, "version": 1, "versionNonce": 2065140927, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Bigger chunks give more context per hit but fuzzier matches.\nSmaller chunks give sharper matches but less context. A\ncommon upgrade is AST-based chunking: parse the Java (e.g.\nwith JavaParser) and cut on class/method boundaries, then\nfall back to line windows for huge methods.", "originalText": "Bigger chunks give more context per hit but fuzzier matches.\nSmaller chunks give sharper matches but less context. A\ncommon upgrade is AST-based chunking: parse the Java (e.g.\nwith JavaParser) and cut on class/method boundaries, then\nfall back to line windows for huge methods.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "ty6m79fmw04u923o359t", "type": "rectangle", "x": 0, "y": 9669.5, "width": 1900, "height": 1131.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1115765601, "version": 1, "versionNonce": 222941689, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "e51h3wqa1vrgss8k5iju", "type": "text", "x": 40, "y": 9699.5, "width": 1464.0, "height": 50.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 663151583, "version": 1, "versionNonce": 1344156672, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "7. Embeddings & the vector store  (RepositoryIndexingService)", "originalText": "7. Embeddings & the vector store  (RepositoryIndexingService)", "fontSize": 40, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "p98rl9qfcpk7pwtg21hs", "type": "text", "x": 40, "y": 9757.5, "width": 776.1600000000001, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 687228825, "version": 1, "versionNonce": 1645875521, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "How a chunk of code becomes a row in PostgreSQL that can be found by meaning.", "originalText": "How a chunk of code becomes a row in PostgreSQL that can be found by meaning.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "4kfmm0qpop1o8m291azh", "type": "rectangle", "x": 40.0, "y": 9810.0, "width": 250, "height": 130, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["tdkvuff124vf89x22j7q"], "frameId": null, "roundness": {"type": 3}, "seed": 1539042909, "version": 1, "versionNonce": 549604051, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "knl2luhhs4dilrzq8bxy", "type": "text", "x": 119.1, "y": 9845.125, "width": 91.8, "height": 21.25, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["tdkvuff124vf89x22j7q"], "frameId": null, "roundness": null, "seed": 1951820716, "version": 1, "versionNonce": 1517172836, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "CodeChunk", "originalText": "CodeChunk", "fontSize": 17, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rkvndxjn7de0l1offkhd", "type": "text", "x": 92.19999999999999, "y": 9872.375, "width": 145.60000000000002, "height": 32.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["tdkvuff124vf89x22j7q"], "frameId": null, "roundness": null, "seed": 526620262, "version": 1, "versionNonce": 704035580, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "filePath, startLine,\nendLine, content", "originalText": "filePath, startLine,\nendLine, content", "fontSize": 13, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "u1jtka1c2zl46q5gqqly", "type": "arrow", "x": 294.0, "y": 9875.0, "width": 56.0, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 1511958013, "version": 1, "versionNonce": 556253717, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "points": [[0, 0], [56.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "0u92t24d7v911pjq50xc", "type": "rectangle", "x": 354.0, "y": 9810.0, "width": 250, "height": 130, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["j0aeoorbt6sapbs22ruw"], "frameId": null, "roundness": {"type": 3}, "seed": 1391225505, "version": 1, "versionNonce": 1235283642, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "msy3paua3aipjiylqx1u", "type": "text", "x": 438.2, "y": 9837.0,