tyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["rqntjvu2cgxu5wahzg85"], "frameId": null, "roundness": {"type": 3}, "seed": 468442790, "version": 1, "versionNonce": 593884593, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "8uxz3adhf025loxyphwh", "type": "text", "x": 68.0, "y": 11936.0, "width": 441.0, "height": 87.5, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["rqntjvu2cgxu5wahzg85"], "frameId": null, "roundness": null, "seed": 758444388, "version": 1, "versionNonce": 403728416, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "image: pgvector/pgvector:pg17\nports: \"127.0.0.1:5433:5432\"\nPOSTGRES_PASSWORD: ${DB_PASSWORD:?Set DB_PASSWORD}\nvolumes: postgres_data\nhealthcheck: pg_isready", "originalText": "image: pgvector/pgvector:pg17\nports: \"127.0.0.1:5433:5432\"\nPOSTGRES_PASSWORD: ${DB_PASSWORD:?Set DB_PASSWORD}\nvolumes: postgres_data\nhealthcheck: pg_isready", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "54xr8pjpf240shdkkg1r", "type": "text", "x": 56.0, "y": 12045.5, "width": 546.5600000000001, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["rqntjvu2cgxu5wahzg85"], "frameId": null, "roundness": null, "seed": 1637742624, "version": 1, "versionNonce": 1137290933, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "PostgreSQL with the pgvector extension already installed. It\nlistens only on localhost, on port 5433 to avoid clashing\nwith a local Postgres. ':?' makes compose fail if DB_PASSWORD\nisn't set. The volume keeps the data between restarts.", "originalText": "PostgreSQL with the pgvector extension already installed. It\nlistens only on localhost, on port 5433 to avoid clashing\nwith a local Postgres. ':?' makes compose fail if DB_PASSWORD\nisn't set. The volume keeps the data between restarts.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e0hdj7o9x66d7wdjv07i", "type": "rectangle", "x": 656.6666666666666, "y": 11873.0, "width": 586.6666666666666, "height": 287.0, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "#c5f6fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["jd5sloc8d6ji874u77w9"], "frameId": null, "roundness": {"type": 3}, "seed": 1022228989, "version": 1, "versionNonce": 1479609143, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "a8lytuagdl1j2vwy8umn", "type": "text", "x": 672.6666666666666, "y": 11889.0, "width": 192.0, "height": 25.0, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["jd5sloc8d6ji874u77w9"], "frameId": null, "roundness": null, "seed": 1341359581, "version": 1, "versionNonce": 421483905, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "application.yaml", "originalText": "application.yaml", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "6l4m1trpuyd6i5ho9cy9", "type": "text", "x": 672.6666666666666, "y": 11924.0, "width": 546.5600000000001, "height": 220.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["jd5sloc8d6ji874u77w9"], "frameId": null, "roundness": null, "seed": 947644098, "version": 1, "versionNonce": 1542818756, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "• datasource → jdbc:postgresql://localhost:5433/repopilot\n• jpa.ddl-auto: validate → Hibernate checks the schema, never\n  changes it\n• flyway.enabled → runs db/migration/V*.sql in order at\n  startup\n• spring.ai.google.genai.* → chat + embedding models, 1536\n  dims\n• spring.ai.vectorstore.pgvector.* → table name,\n  COSINE_DISTANCE, HNSW, initialize-schema: false\n• Secrets (GOOGLE_API_KEY, DB_PASSWORD) come from environment\n  variables, never from the file", "originalText": "• datasource → jdbc:postgresql://localhost:5433/repopilot\n• jpa.ddl-auto: validate → Hibernate checks the schema, never\n  changes it\n• flyway.enabled → runs db/migration/V*.sql in order at\n  startup\n• spring.ai.google.genai.* → chat + embedding models, 1536\n  dims\n• spring.ai.vectorstore.pgvector.* → table name,\n  COSINE_DISTANCE, HNSW, initialize-schema: false\n• Secrets (GOOGLE_API_KEY, DB_PASSWORD) come from environment\n  variables, never from the file", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "c1qy9mbaaxa3bl13vcg8", "type": "rectangle", "x": 1273.3333333333333, "y": 11873.0, "width": 586.6666666666666, "height": 223.5, "angle": 0, "strokeColor": "#0c8599", "backgroundColor": "#c5f6fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["jg107r925dsiuaz71uf0"], "frameId": null, "roundness": {"type": 3}, "seed": 211013027, "version": 1, "versionNonce": 942700338, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "9uyg3ibg3hkcqwb00n11", "type": "text", "x": 1289.3333333333333, "y": 11889.0, "wid