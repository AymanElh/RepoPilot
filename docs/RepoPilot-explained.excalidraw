ainerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "p52ay7ov50ew25x1fvk1", "type": "arrow", "x": 608.0, "y": 11146.5, "width": 56.0, "height": 0.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 929305358, "version": 1, "versionNonce": 1288107474, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "points": [[0, 0], [56.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "z7vxuqdrmswjjjksl66u", "type": "rectangle", "x": 668.0, "y": 11081.5, "width": 250, "height": 130, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["bcd6fxnoq37ktll8sn5y"], "frameId": null, "roundness": {"type": 3}, "seed": 748426425, "version": 1, "versionNonce": 2088085725, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "l3sojpx16f1kyntl2ug0", "type": "text", "x": 716.5, "y": 11124.75, "width": 153.0, "height": 21.25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["bcd6fxnoq37ktll8sn5y"], "frameId": null, "roundness": null, "seed": 1881508506, "version": 1, "versionNonce": 625907978, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "embed(question)", "originalText": "embed(question)", "fontSize": 17, "fontFamily": 1, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "wh23gxrirjutfvj839ag", "type": "text", "x": 