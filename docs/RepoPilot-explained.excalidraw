solid", "roughness": 1, "opacity": 100, "groupIds": ["w9heyce4qgm5v2wwg84d"], "frameId": null, "roundness": null, "seed": 72199589, "version": 1, "versionNonce": 914178736, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Why 4 endpoints for one pipeline?", "originalText": "Why 4 endpoints for one pipeline?", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "tr23qiua08ekxdrkz40a", "type": "text", "x": 56.0, "y": 4935.0, "width": 833.2800000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["w9heyce4qgm5v2wwg84d"], "frameId": null, "roundness": null, "seed": 976763175, "version": 1, "versionNonce": 995918394, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "They are development steps that each go one stage further, so you can test every stage on its\nown:", "originalText": "They are development steps that each go one stage further, so you can test every stage on its\nown:", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "15o2nqw4c6lbpj8t22c5", "type": "rectangle", "x": 56.0, "y": 4985.0, "width": 863.0, "height": 94.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["w9heyce4qgm5v2wwg84d"], "frameId": null, "roundness": {"type": 3}, "seed": 1580034251, "version": 1, "versionNonce": 2001977173, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "b8y5dnwnguczh9ier7u8", "type": "text", "x": 68.0, "y": 4997.0, "width": 476.28000000000003, "height": 70.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["w9heyce4qgm5v2wwg84d"], "frameId": null, "roundness": null, "seed": 450529123, "version": 1, "versionNonce": 1617427770, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "GET  /info      → steps 1-2\nGET  /download  → steps 1-3 (keeps the zip!)\nGET  /chunks    → steps 1-6 + cleanup (nothing stored)\nPOST /index     → steps 1-8", "originalText": "GET  /info      → steps 1-2\nGET  /download  → steps 1-3 (keeps the zip!)\nGET  /chunks    → steps 1-6 + cleanup (nothing stored)\nPOST /index     → steps 1-8", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "0imjyjcmrsezytkw2837", "type": "text", "x": 56.0, "y": 5089.0, "width": 663.0400000000001, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["w9heyce4qgm5v2wwg84d"], "frameId": null, "roundness": null, "seed": 140934192, "version": 1, "versionNonce": 404486236, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Note: /download never deletes its zip, so each call leaves a file in /tmp.", "originalText": "Note: /download never deletes its zip, so each call leaves a file in /tmp.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "0p92k38p6fvdhr59c81d", "type": "rectangle", "x": 965.0, "y": 4884.0, "width": 895.0, "height": 316.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["c5i8xomxlvz4qke2gjr8"], "frameId": null, "roundness": {"type": 3}, "seed": 879310026, "version": 1, "versionNonce": 1371825434, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "1bmqf7zk94yxfiblejgu", "type": "text", "x": 981.0, "y": 4900.0, "width": 576.0, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["c5i8xomxlvz4qke2gjr8"], "frameId": null, "roundness": null, "seed": 74494248, "version": 1, "versionNonce": 1429264792, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "The try / finally cleanup pattern (from index())", "originalText": "The try / finally cleanup pattern (from index())", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "lmntfk7orfqla09lzrk7", "type": "rectangle", "x": 981.0, "y": 4935.0, "width": 863.0, "height": 199.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["c5i8xomxlvz4qke2gjr8"], "frameId": null, "roundness": {"type": 3}, "seed": 2106015253, "version": 1, "versionNonce": 2134739911, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "ufu6py06ftlo4qdbxvh7", "type": "text", "x": 993.0, "y": 4947.0, "width": 564.48, "height": 175.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["c5i8xomxlvz4qke2gjr8"], "frameId": null, "roundness": null, "seed": 596844051, "version": 1, "versionNonce": 420296224, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Path zipFile = archiveClient.download(...);\nPath directory = null;\ntry {\n    directory = extractor.extract(zipFile);\n    ... chunk + index ...\n    return Map.of(...);\n} finally {\n    Files.deleteIfExists(zipFile);\n    if (directory != null) extractor.deleteDirectory(directory);\n}", "originalText": "Path zipFile = archiveClient.download(...);\nPath directory = null;\ntry {\n    directory = extractor.extract(zipFile);\n    ... chunk + index ...\n    return Map.of(...);\n} finally {\n    Files.deleteIfExists(zipFile);\n    if (directory != null) extractor.deleteDirectory(directory);\n}", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "atqydshlv76mf4nnkm95", "type": "text", "x": 981.0, "y": 5144.0, "width": 860.1600000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["c5i8xomxlvz4qke2gjr8"], "frameId": null, "roundness": null, "seed": 188116634, "version": 1, "versionNonce": 463201821, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "directory starts as null because extract() may fail before it returns. The /chunks version nests\na second try/finally, so the zip is still deleted even if deleting the folder throws.", "originalText": "directory starts as null because extract() may fail before it returns. The /chunks version nests\na second try/finally, so the zip is still deleted even if deleting the folder throws.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "vna31xbidfwa88d0mzhr", "type": "rectangle", "x": 0, "y": 5380.0, "width": 1900, "height": 2128.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1208713813, "version": 1, "versionNonce": 1916393561, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "x6pryiej9c0uu5wryesu", "type": "text", "x": 40, "y": 5410.0, "width": 960.0, "height": 50.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1815225134, "version": 1, "versionNonce": 557351869, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "4. The Java IO you need for this project", "originalText": "4. The Java IO you need for this project", "fontSize": 40, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "fcl5efjp6mkt7s1gd1t5", "type": "text", "x": 40, "y": 5468.0, "width": 1249.92, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1775586708, "version": 1, "versionNonce": 1814612695, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Everything about files, bytes and streams the project uses: java.nio.file (Path, Files), java.io streams, and java.util.zip.", "originalText": "Everything about files, bytes and streams the project uses: java.nio.file (Path, Files), java.io streams, and java.util.zip.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "9rdpxdfovd79c9mv9e40", "type": "rectangle", "x": 40.0, "y": 5520.5, "width": 895.0, "height": 293.5, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#ffe8cc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ykyydu3asnrm6dfhg6w3"], "frameId": null, "roundness": {"type": 3}, "seed": 598113557, "version": 1, "versionNonce": 1642432021, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "stt1eqc37rln36v1mzb3", "type": "text", "x": 56.0, "y": 5536.5, "width": 564.0, "height": 25.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ykyydu3asnrm6dfhg6w3"], "frameId": null, "roundness": null, "seed": 477509846, "version": 1, "versionNonce": 276412234, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Path vs Files  (java.nio.file, the 'NIO.2' API)", "originalText": "Path vs Files  (java.nio.file, the 'NIO.2' API)", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "4fieecy2c11bd2scejcy", "type": "text", "x": 56.0, "y": 5571.5, "width": 860.1600000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ykyydu3asnrm6dfhg6w3"], "frameId": null, "roundness": null, "seed": 1620384379, "version": 1, "versionNonce": 207239897, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Path = an ADDRESS of a file or folder, like a String with super-powers. Creating a Path does NOT\ntouch the disk; the file may not even exist.", "originalText": "Path = an ADDRESS of a file or folder, like a String with super-powers. Creating a Path does NOT\ntouch the disk; the file may not even exist.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "27h6gmd478mfs0iuduah", "type": "rectangle", "x": 56.0, "y": 5621.5, "width": 863.0, "height": 146.5, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["ykyydu3asnrm6dfhg6w3"], "frameId": null, "roundness": {"type": 3}, "seed": 411345161, "version": 1, "versionNonce": 2070740748, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "k6t9dhsznvp8gmnhie9e", "type": "text", "x": 68.0, "y": 5633.5, "width": 599.76, "height": 122.5, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ykyydu3asnrm6dfhg6w3"], "frameId": null, "roundness": null, "seed": 236902157, "version": 1, "versionNonce": 1116106495, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Path root  = Path.of(\"/tmp/repopilot-src-5521\");\nPath file  = root.resolve(\"petclinic/src/Owner.java\"); // join\nPath rel   = root.relativize(file);   // petclinic/src/Owner.java\nPath clean = Path.of(\"/a/b/../c\").normalize();   // /a/c\nPath real  = file.toRealPath();  // absolute, symlinks resolved,\n                                 // throws if the file doesn't exist\nboolean in = file.startsWith(root);  // compares path segments", "originalText": "Path root  = Path.of(\"/tmp/repopilot-src-5521\");\nPath file  = root.resolve(\"petclinic/src/Owner.java\"); // join\nPath rel   = root.relativize(file);   // petclinic/src/Owner.java\nPath clean = Path.of(\"/a/b/../c\").normalize();   // /a/c\nPath real  = file.toRealPath();  // absolute, symlinks resolved,\n                                 // throws if the file doesn't exist\nboolean in = file.startsWith(root);  // compares path segments", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e1zublekvl9ptk4gc4ry", "type": "text", "x": 56.0, "y": 5778.0, "width": 707.84, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["ykyydu3asnrm6dfhg6w3"], "frameId": null, "roundness": null, "seed": 385037998, "version": 1, "versionNonce": 27457390, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Files = a class full of static methods that DO touch the disk. They take Paths.", "originalText": "Files = a class full of static methods that DO touch the disk. They take Paths.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "dyms1mwnpr424tkb9oi0", "type": "rectangle", "x": 965.0, "y": 5520.5, "width": 895.0, "height": 351.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "#ffe8cc", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["zuj2xorvork1djrwedbc"], "frameId": null, "roundness": {"type": 3}, "seed": 197477946, "version": 1, "versionNonce": 1541263702, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "y8nyfwdc112hxrjm4t8b", "type": "text", "x": 981.0, "y": 5536.5, "width": 372.0, "height": 25.0, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["zuj2xorvork1djrwedbc"], "frameId": null, "roundness": null, "seed": 924290718, "version": 1, "versionNonce": 1890055485, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Files methods used in RepoPilot", "originalText": "Files methods used in RepoPilot", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "6nlnqbu4kzrezrdyxyur", "type": "rectangle", "x": 981.0, "y": 5571.5, "width": 863.0, "height": 234.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["zuj2xorvork1djrwedbc"], "frameId": null, "roundness": {"type": 3}, "seed": 1834705823, "version": 1, "versionNonce": 335675227, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "sor8wm9lbb4m0a6mdmmm", "type": "text", "x": 993.0, "y": 5583.5, "width": 590.94, "height": 210.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["zuj2xorvork1djrwedbc"], "frameId": null, "roundness": null, "seed": 1420002098, "version": 1, "versionNonce": 524477539, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Files.createTempFile(\"repopilot\", \".zip\")  // /tmp/repopilot123.zip\nFiles.createTempDirectory(\"repopilot-src-\")\nFiles.write(path, bytes)          // byte[] → file\nFiles.size(path)                  // in bytes\nFiles.readAllLines(path, UTF_8)   // file → List<String>\nFiles.readString(path)            // file → String (tests)\nFiles.newInputStream(path)        // open for reading bytes\nFiles.newOutputStream(path)       // open for writing bytes\nFiles.createDirectories(path)     // mkdir -p\nFiles.walk(dir)                   // Stream<Path> of the tree\nFiles.isRegularFile / isDirectory / exists\nFiles.deleteIfExists(path)        // a folder must be empty!", "originalText": "Files.createTempFile(\"repopilot\", \".zip\")  // /tmp/repopilot123.zip\nFiles.createTempDirectory(\"repopilot-src-\")\nFiles.write(path, bytes)          // byte[] → file\nFiles.size(path)                  // in bytes\nFiles.readAllLines(path, UTF_8)   // file → List<String>\nFiles.readString(path)            // file → String (tests)\nFiles.newInputStream(path)        // open for reading bytes\nFiles.newOutputStream(path)       // open for writing bytes\nFiles.createDirectories(path)     // mkdir -p\nFiles.walk(dir)                   // Stream<Path> of the tree\nFiles.isRegularFile / isDirectory / exists\nFiles.deleteIfExists(path)        // a folder must be empty!", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "ixv6ckmalq5u6jzv9nou", "type": "text", "x": 981.0, "y": 5815.5, "width": 860.1600000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["zuj2xorvork1djrwedbc"], "frameId": null, "roundness": null, "seed": 1735868083, "version": 1, "versionNonce": 1048742159, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Temp files land in the OS temp folder (/tmp on Linux). Nobody deletes them for you, which is why\nevery endpoint cleans up in finally.", "originalText": "Temp files land in the OS temp folder (/tmp on Linux). Nobody deletes them for you, which is why\nevery endpoint cleans up in finally.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "4dmc2rh2xk2pthowq1ga", "type": "text", "