02.5, "width": 554.6666666666666, "height": 129.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["rcq97rcq6w948ju63lxs"], "frameId": null, "roundness": {"type": 3}, "seed": 1016133722, "version": 1, "versionNonce": 2101009151, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "b7ei5r8vo4kvfflncc2a", "type": "text", "x": 68.0, "y": 11314.5, "width": 449.82, "height": 105.0, "angle": 0, "strokeColor": "#212529", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["rcq97rcq6w948ju63lxs"], "frameId": null, "roundness": null, "seed": 1160436707, "version": 1, "versionNonce": 920288271, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "SearchRequest.builder()\n  .query(question)        // text, embedded for you\n  .topK(3)                // at most 3 results\n  .similarityThreshold(0.0) // keep everything\n  .filterExpression(\"repositoryId == 'demo-repo'\")\n  .build();", "originalText": "SearchRequest.builder()\n  .query(question)        // text, embedded for you\n  .topK(3)                // at most 3 results\n  .similarityThreshold(0.0) // keep everything\n  .filterExpression(\"repositoryId == 'demo-repo'\")\n  .build();", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rd83x9age9ny3mub6lbu", "type": "text", "x": 56.0, "y": 11441.5, "width": 519.6800000000001, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["rcq97rcq6w948ju63lxs"], "frameId": null, "roundness": null, "seed": 2122110430, "version": 1, "versionNonce": 84855069, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "score = similarity (higher = better). A threshold like 0.6\nwould drop weak matches.", "originalText": "score = similarity (higher = better). A threshold like 0.6\nwould drop weak matches.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "x0st69wwp82qztt1blow", "type": "rectangle", "x": 656.6666666666666, "y": 11251.5, "width": 586.6666666666666, "height": 197.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4xz3mskzo3i9lliffcve"], "frameId": null, "roundness": {"type": 3}, "seed": 1700459770, "version": 1, "versionNonce": 134858688, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "dqfc1yuzpex7tv7hrbfg", "type": "text", "x": 672.6666666666666, "y": 11267.5, "width": 240.0, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4xz3mskzo3i9lliffcve"], "frameId": null, "roundness": null, "seed": 141852800, "version": 1, "versionNonce": 105038121, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "⚠ Current limitation", "originalText": "⚠ Current limitation", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "b4jgrxozlel8pl6uza28", "type": "text", "x": 672.6666666666666, "y": 11302.5, "width": 528.6400000000001, "height": 100.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4xz3mskzo3i9lliffcve"], "frameId": null, "roundness": null, "seed": 892925934, "version": 1, "versionNonce": 200180553, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "The filter is hard-coded to 'demo-repo', which only matches\nthe 3 samples from POST /seed. Repos indexed through /index\nare stored with repositoryId = \"owner/name\" (e.g.\n\"spring-projects/spring-petclinic\"), so search can't find\nthem yet.", "originalText": "The filter is hard-coded to 'demo-repo', which only matches\nthe 3 samples from POST /seed. Repos indexed through /index\nare stored with repositoryId = \"owner/name\" (e.g.\n\"spring-projects/spring-petclinic\"), so search can't find\nthem yet.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "r9f5iv86zp1wz2nar3sh", "type": "text", "x": 672.6666666666666, "y": 11412.5, "width": 465.9200000000001, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["4xz3mskzo3i9lliffcve"], "frameId": null, "roundness": null, "seed": 714076796, "version": 1, "versionNonce": 1461052765, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Next step: take repositoryId as a request parameter.", "originalText": "Next step: take repositoryId as a request parameter.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "bqam97xo485d4vueer90", "type": "rectangle", "x": 1273.3333333333333, "y": 11251.5, "width": 586.6666666666666, "height": 301.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["r576vilvqkxbi6jjtb8q"], "frameId": null, "roundness": {"type": 3}, "seed": 731654836, "version": 1, "versionNonce": 257167710, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false}, {"id": "op82j3tps82xlvb9hxke", "type": "text", "x": 1289.3333333333333, "y": 11267.5, "width": 372.0, "height": 25.0, "angle": 0, "strokeColor": "#f08c00", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["r576vilvqkxbi6jjtb8q"], "frameId": null, "roundness": null, "seed": 504300899, "version": 1, "versionNonce": 1987773460, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "What comes next: the 'G' in RAG", "originalText": "What comes next: the 'G' in RAG", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "9ulthycx8ae0jxyo6hfd", "type": "text", "x": 1289.3333333333333, "y": 11302.5, "width": 510.72, "height": 80.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": ["r576vilvqkxbi6jjtb8q"], "frameId": null, "roundness": null, "seed": 2000899574, "version": 1, "versionNonce": 620147125, "isDeleted": false, "boundElements": null, "updated": 1795031332816, "link": null, "locked": false, "text": "Retrieval works. Generation is the missing piece: build a\nprompt containing the top chunks (with file and line\nmetadata) plus the question, then send it through the\nChatClient that AITestController already uses:", "originalText": "Retrieval works. Generation is the missing piece: build a\nprompt containing the top chunks (with file and line\nmetadata) plus the question, then send it through the\nChatClient that AIT